{
  "name": "shiroor-matha",
  "version": "0.1.0",
  "private": true,
  "description": "Static, multilingual website for Shri Shiroor Matha.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VedavardhanaTheertha/MainWebsiteUI.git"
  },
  "bugs": "https://github.com/VedavardhanaTheertha/MainWebsiteUI/issues",
  "homepage": "https://shiroormatha.org",
  "engines": {
    "node": ">=20.9 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "postinstall": "node scripts/patch-next-font.mjs",
    "dev": "node build/dev.mjs",
    "dev:local": "node build/dev.mjs local",
    "build": "node build/build.mjs",
    "start": "node build/preview.mjs",
    "clean": "node build/clean.mjs",
    "prelint": "npm run content:build",
    "lint": "eslint . --max-warnings=0",
    "bhakti:build": "node build/build-bhakti-content.mjs",
    "sevas:build": "node build/build-sevas-content.mjs",
    "events:build": "node build/build-events-content.mjs",
    "library:build": "node build/build-library-sections.mjs",
    "settings:build": "node build/build-ui-settings.mjs",
    "theme:build": "node build/build-theme-settings.mjs",
    "media:build": "node build/build-media-albums.mjs",
    "content:build": "node build/generate.mjs",
    "typecheck": "npm run content:build && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node build/test.mjs",
    "content:validate": "npm run content:build",
    "check": "node build/check.mjs",
    "ci": "npm run check && npm run build:dev && npm run build:prod",
    "build:local": "node build/build.mjs local",
    "build:dev": "node build/build.mjs dev",
    "build:prod": "node build/build.mjs prod",
    "verify": "node build/verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "markdown-it": "^15.0.2",
    "minisearch": "^7.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "js-yaml": "^4.3.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "serve-handler": "^6.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
